              }
            },
            {
              "id": "cond-estimate",
              "leftValue": "={{ $node[\"Pricing Store \"].json.pricing.estimate }}",
              "rightValue": 300,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
