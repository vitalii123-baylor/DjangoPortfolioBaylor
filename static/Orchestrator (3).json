      "typeVersion": 2,
      "position": [
        -240,
        208
      ],
      "id": "ce97c916-3c9b-4263-b93c-c6428439e689",
      "name": "IF"
    },
    {
      "parameters": {
        "jsCode": "return items.map((item, index) => {\n  // Используем $(...).item.json, чтобы n8n автоматически \n  // подтянул данные именно для ТЕКУЩЕГО индекса (0, 1, 2...)\n  \n  const job = $(\"Job Store\").item.json.job;\n  \n  // ВНИМАНИЕ: Проверь, есть ли пробел в названии узлов \"Pricing Store \" \n  // и \"Schedule Store \". В твоем коде он был, я его оставил.\n  const pricing = $(\"Pricing Store \").item.json.pricing;\n  const scheduling = $(\"Schedule Store \").item.json.scheduling;\n  const firstName = $(\"Data from Sheet\").item.json.client_first_name;\n\n  return {\n    json: {\n      commsPayload: {\n        job: job,\n        pricing: pricing,\n        scheduling: scheduling,\n        email_type: \"client\",\n        client_name: firstName\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        400
      ],
      "id": "78d0e3fd-e913-4a08-9868-f21afc0a7501",
      "name": "Payload"
    },
    {
      "parameters": {
        "jsCode": "return items.map((item, index) => {\n  // Используем $(...).item, чтобы сопоставить данные по индексу: \n  // первый в \"Job Store\" к первому в текущем узле и т.д.\n  \n  const job = $(\"Job Store\").item.json.job;\n  \n  // Проверь наличие пробелов в названиях узлов (в твоем коде они были)\n  const pricing = $(\"Pricing Store \").item.json.pricing;\n  const scheduling = $(\"Schedule Store \").item.json.scheduling;\n  \n  // Данные из узла Data from Sheet\n  const sheetData = $(\"Data from Sheet\").item.json;\n\n  return {\n    json: {\n      commsPayload: {\n        job: job,\n        pricing: pricing,\n        scheduling: scheduling,\n        email_type: \"operations\",\n        client_name: sheetData.client_name,\n        client_email: sheetData.client_email\n      }\n    }\n  };\n});"
      },
