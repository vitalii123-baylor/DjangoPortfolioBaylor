      "id": "7f075c92-d835-4a9d-a12a-d799d023d05a",
      "name": "Call Scheduling"
    },
    {
      "parameters": {
        "jsCode": "// Проходимся по всем входящим объектам (items)\nreturn items.map(item => {\n  const data = item.json; // Берем данные текущего объекта\n  const keys = Object.keys(data);\n\n  // Улучшенная функция поиска\n  function find(keyword, excludeKeyword = null) {\n    const k = keys.find(key => {\n      const lowerKey = key.toLowerCase();\n      const containsTarget = lowerKey.includes(keyword.toLowerCase());\n      // Если есть исключение (например, не брать \"email\" когда ищем \"address\")\n      const matchesExclude = excludeKeyword && lowerKey.includes(excludeKeyword.toLowerCase());\n      return containsTarget && !matchesExclude;\n    });\n    return k ? (data[k] || \"\") : \"\";\n  }\n\n  // Извлекаем данные с более точными приоритетами\n  const fullName = (find(\"Your Name\") || find(\"full name\") || find(\"name\") || \"\").toString();\n  const email = (find(\"email\") || \"\").toString();\n  \n  // Ищем адрес, исключая ключи, где есть \"email\"\n  const address = (find(\"service address\") || find(\"address\", \"email\") || \"\").toString();\n  \n  const description = (find(\"describe\") || find(\"service need\") || find(\"description\") || \"\").toString();\n\n  const firstName = fullName.trim().split(\" \")[0] || \"\";\n  const message = `${description}\\nService address: ${address}`;\n\n  return {\n    json: {\n      client_name: fullName.trim(),\n      client_first_name: firstName,\n      client_email: email.trim(),\n      service_address: address.trim(),\n      message: message\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1776,
        208
      ],
      "id": "581ebb86-a267-4bb3-be6f-b7422f0ab83e",
      "name": "Data from Sheet"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  // item.json — это данные текущего объекта в цикле\n  const data = item.json;\n\n  return {\n    json: {\n      job: {\n        // Проверяем наличие services или оборачиваем одиночный service в массив\n        services: data.services || (data.service ? [data.service] : []),\n        address: data.address,\n        unit: data.unit,\n        zip: data.zip,\n        urgency: data.urgency,\n        preferred_days: data.preferred_days,\n        notes: data.notes\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1344,
        208
      ],
      "id": "9eb06624-8a99-4f3b-a356-cf9df2e63b19",
      "name": "Job Store"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  return {\n    json: {\n      pricing: {\n        estimate: item.json.estimate,\n        breakdown: item.json.breakdown,\n        currency: item.json.currency\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -896,
        208
      ],
      "id": "3f9b1eb3-8360-4759-b2d3-9516a8fddcd0",
      "name": "Pricing Store "
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  return {\n    json: {\n      scheduling: {\n        proposed_slots: item.json.proposed_slots,\n        note: item.json.note\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
