      "parameters": {
        "jsCode": "// After an HTTP Request node, the current $json may be the time API response.\n// To reliably read the original webhook input, reference the Webhook node directly:\nconst preferred = $node[\"Webhook\"].json.body.preferred_days || [];\nconst slots = [\n\"Thu 4:30pm\",\n\"Thu 5:30pm\",\n\"Sat 9:00am\",\n\"Sat 10:30am\",\n\"Sun 1:00pm\",\n];\nlet filtered = slots;\nif (preferred.length > 0) {\nfiltered = slots.filter(s => preferred.some(d => s.startsWith(d)));\n}\nreturn [{\nproposed_slots: filtered.slice(0, 3),\nnote: \"Reply with a slot to confirm. Arrival window is 2 hours.\"\n}];\n"
